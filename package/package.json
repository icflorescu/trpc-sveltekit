{
  "name": "trpc-sveltekit",
  "version": "4.0.0",
  "description": "SvelteKit adapter for tRPC.io, working with any SvelteKit adapter",
  "keywords": [
    "trpc",
    "svelte",
    "sveltekit",
    "kit",
    "adapter",
    "handle",
    "typescript",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icflorescu/trpc-sveltekit.git",
    "directory": "package"
  },
  "homepage": "https://icflorescu.github.io/trpc-sveltekit/",
  "bugs": {
    "url": "https://github.com/icflorescu/trpc-sveltekit/issues"
  },
  "author": {
    "name": "Ionut-Cristian Florescu",
    "email": "ionut.florescu@gmail.com",
    "url": "https://github.com/icflorescu"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/icflorescu"
  },
  "license": "ISC",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "default": "./dist/websocket/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp ../README.md ../LICENSE .",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/kit": "^3.1.1",
    "@trpc/client": "^11.25.2",
    "@trpc/server": "^11.25.2",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0 || ^3.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "ws": "^8.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
