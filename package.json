{
  "name": "trpc-sveltekit-monorepo",
  "version": "0.0.0",
  "description": "SvelteKit adapter for trpc.io",
  "author": {
    "name": "Ionut-Cristian Florescu",
    "email": "ionut.florescu@gmail.com",
    "url": "https://github.com/icflorescu"
  },
  "license": "ISC",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:package": "pnpm --filter trpc-sveltekit build",
    "dev": "pnpm build:package && pnpm -r --parallel dev",
    "check": "pnpm build:package && pnpm -r check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "typescript": "~6.0.3"
  }
}
